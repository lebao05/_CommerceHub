@model LoginInputModel
@{
    ViewData["Title"] = "Sign in";
}
<section class="panel">
    <h1>Sign in</h1>
    <p>Use your CommerceHub account to continue.</p>
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <form asp-controller="Account" asp-action="Login" method="post">
        <input asp-for="ReturnUrl" type="hidden" />
        <label asp-for="Username"></label>
        <input asp-for="Username" autocomplete="username" autofocus />
        <span asp-validation-for="Username" class="validation"></span>
        <label asp-for="Password"></label>
        <input asp-for="Password" autocomplete="current-password" />
        <span asp-validation-for="Password" class="validation"></span>
        <label class="remember"><input asp-for="RememberLogin" /> Remember me</label>
        <button type="submit">Sign in</button>
    </form>
    @if (Model.GoogleLoginEnabled)
    {
        <p><a asp-controller="External" asp-action="Challenge" asp-route-scheme="Google"
              asp-route-returnUrl="@Model.ReturnUrl">Continue with Google</a></p>
    }
</section>
