@model IEnumerable<Duende.IdentityServer.Models.Grant>
@{
    ViewData["Title"] = "Authorized applications";
}
<section class="panel">
    <h1>Authorized applications</h1>
    @if (!Model.Any())
    {
        <p>You have not authorized any applications.</p>
    }
    @foreach (var grant in Model)
    {
        <article class="grant">
            <h2>@grant.ClientId</h2>
            <p>@string.Join(", ", grant.Scopes)</p>
            @if (!string.IsNullOrWhiteSpace(grant.Description))
            {
                <p>@grant.Description</p>
            }
            <form asp-controller="Grants" asp-action="Revoke" method="post">
                <input type="hidden" name="clientId" value="@grant.ClientId" />
                <button class="secondary" type="submit">Revoke access</button>
            </form>
        </article>
    }
</section>
