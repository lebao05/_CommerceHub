{
  "Gateway": {
    "Identity": {
      "Issuer": "http://localhost:5063/"
    },
    "Cors": {
      "Origins": [
        "http://localhost:5173",
        "http://localhost:5174"
      ]
    },
    "Services": {
      "Identity": {
        "Host": "http://localhost",
        "Port": 5063
      },
      "ProductCatalog": {
        "Host": "http://localhost",
        "Port": 5209
      },
      "Order": {
        "Host": "http://localhost",
        "Port": 5141
      },
      "Inventory": {
        "Host": "http://localhost",
        "Port": 5233
      },
      "Payment": {
        "Host": "http://localhost",
        "Port": 5172
      }
    },
    "RateLimiting": {
      "Global": {
        "PermitLimit": 300,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "Authentication": {
        "PermitLimit": 20,
        "WindowSeconds": 60,
        "QueueLimit": 0
      }
    },
    "Swagger": {
      "ClientId": "commercehub-firstparty"
    }
  },
  "Session": {
    "IdleMinutes": 30,
    "AbsoluteDays": 7,
    "RefreshWindowSeconds": 60,
    "Redis": "localhost:6379",
    "CookieName": "ch_session",
    "GatewayClientId": "commercehub-gateway",
    "StorefrontOrigin": "http://localhost:5173",
    "AdminOrigin": "http://localhost:5174",
    "GatewayOrigin": "http://localhost:5108",
    "AllowedClients": [ "commercehub-web", "admin-dashboard" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Yarp": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/apigateway-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] [{CorrelationId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
